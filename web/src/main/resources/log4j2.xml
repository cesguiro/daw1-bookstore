<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO"  shutdownHook="disable">
    <Appenders>
        <!-- Log en consola -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} %highlight{%-5level}{FATAL=red, ERROR=red, WARN=yellow, INFO=green, DEBUG=blue, TRACE=magenta} %logger{36} - %msg%n</pattern>
            </PatternLayout>
        </Console>

        <!-- Log en archivo -->
        <File name="FileLogger" fileName="logs/app.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %c{1} - %msg%n" />
        </File>
    </Appenders>

    <Loggers>
        <!-- Logger por defecto -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
        </Root>

        <!-- Logger específico para una clase o paquete -->
        <Logger name="es.cesguiro" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
        </Logger>

    </Loggers>
</Configuration>